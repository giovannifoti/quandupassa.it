<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Manifesto privacy richiesto da Apple.
     - Nessun tracciamento e nessun dominio di tracciamento.
     - Nessun dato raccolto: la posizione è usata solo sul dispositivo e non
       viene trasmessa; preferiti e impostazioni restano sul dispositivo.
     - API con motivazione obbligatoria: UserDefaults (plugin Preferences),
       usato solo per i dati dell'app stessa (CA92.1). -->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
